{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CauseBase Golden Corpus v1",
  "type": "object",
  "required": ["corpus_version", "contract_version", "cases"],
  "properties": {
    "corpus_version": {"const": "1.0"},
    "contract_version": {"const": "0.5"},
    "cases": {
      "type": "array",
      "minItems": 20,
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": ["case_id", "truth_level", "strata", "why"],
        "properties": {
          "case_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "truth_level": {"enum": ["accepted_gold", "review_required"]},
          "strata": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "archive_locator": {"type": "string"},
          "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "expected": {"type": "object"},
          "why": {"type": "string", "minLength": 1}
        },
        "allOf": [{"if": {"required": ["archive_locator"]}, "then": {"required": ["source_sha256"]}}]
      }
    }
  }
}
