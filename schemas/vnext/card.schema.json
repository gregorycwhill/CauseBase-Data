{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://causebase.example/schema/0.5/card.schema.json", "title": "CauseBase public card 0.5 draft", "type": "object",
  "required": ["causebase_id", "contract_version", "subject_kind", "identity", "release", "source_record_refs", "coverage", "evidence"],
  "properties": {
    "causebase_id": {"type": "string", "pattern": "^cb_[a-z0-9]+$"}, "contract_version": {"const": "0.5"}, "subject_kind": {"enum": ["organisation", "organisation_group", "legal_entity", "organisational_unit", "fund", "program", "unknown"]},
    "identity": {"type": "object", "required": ["legal_name", "display_name", "external_identifiers", "registrations", "tax_statuses"], "properties": {"legal_name": {"type": "string"}, "display_name": {"type": "string"}, "operating_names": {"type": "array", "items": {"type": "string"}}, "former_names": {"type": "array", "items": {"type": "string"}}, "entity_status": {"type": ["string", "null"]}, "external_identifiers": {"type": "array", "items": {"type": "object", "required": ["scheme", "value"], "properties": {"scheme": {"type": "string"}, "value": {"type": "string"}, "evidence_ids": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}}, "registrations": {"type": "array", "items": {"type": "object"}}, "tax_statuses": {"type": "array", "items": {"type": "object"}}, "convenience_links": {"type": "object"}}, "additionalProperties": false},
    "release": {"type": "object", "required": ["release_id", "dataset_version", "generated_at"], "properties": {"release_id": {"type": "string"}, "dataset_version": {"type": "string"}, "generated_at": {"type": "string", "format": "date-time"}}, "additionalProperties": false},
    "source_record_refs": {"type": "array", "items": {"type": "string"}}, "source_bindings": {"type": "array", "items": {"type": "object"}}, "evidence": {"type": "array", "items": {"type": "object", "required": ["evidence_id", "title"], "properties": {"evidence_id": {"type": "string"}, "title": {"type": "string"}, "url": {"type": ["string", "null"], "format": "uri"}}, "additionalProperties": true}},
    "summary": {"type": ["object", "null"]}, "descriptive_geography": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/observation"}}, "navigation_geography": {"type": "array", "items": {"type": "object", "required": ["level", "term_id", "label"], "properties": {"level": {"enum": ["country", "state_territory", "region", "locality"]}, "term_id": {"type": "string"}, "label": {"type": "string"}}, "additionalProperties": false}},
    "participation": {"type": "array", "items": {"type": "object", "required": ["participation_id", "mode", "label", "evidence_ids"], "properties": {"participation_id": {"type": "string"}, "mode": {"type": "string"}, "label": {"type": "string"}, "action_url": {"type": ["string", "null"], "format": "uri"}, "evidence_ids": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": true}}, "programs": {"type": "array", "items": {"type": "object"}}, "relationships": {"type": "array", "items": {"type": "object"}}, "classifications": {"type": "array", "items": {"type": "object"}},
    "coverage": {"type": "object", "required": ["current"], "properties": {"current": {"type": "array", "items": {"type": "object", "required": ["capability", "status", "assessed_at"], "properties": {"capability": {"type": "string"}, "status": {"$ref": "common.schema.json#/$defs/coverageStatus"}, "assessed_at": {"type": "string", "format": "date-time"}, "observation_ids": {"type": "array", "items": {"type": "string"}}, "source_record_ids": {"type": "array", "items": {"type": "string"}}, "evidence_ids": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": true}}}, "additionalProperties": false},
    "financial_reports": {"type": "array", "items": {"$ref": "financial.schema.json#/$defs/report"}}, "canonical_metrics": {"type": "array", "items": {"$ref": "financial.schema.json#/$defs/metric"}}, "current_financials": {"$ref": "financial.schema.json#/$defs/currentFinancials"}, "analytic_projections": {"type": "array", "items": {"$ref": "financial.schema.json#/$defs/analyticProjection"}}, "derivatives": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/lineage"}}
  }, "additionalProperties": false
}
