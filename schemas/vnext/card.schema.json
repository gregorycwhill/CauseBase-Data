{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://causebase.example/schema/0.5/card.schema.json","title":"CauseBase public card 0.5 draft","type":"object",
  "$defs":{
    "evidenceBound":{"type":"object","required":["observation_id","label","claim_basis","source_record_ids","evidence_ids"],"properties":{"observation_id":{"type":"string"},"label":{"type":"string"},"claim_basis":{"$ref":"common.schema.json#/$defs/claimBasis"},"extraction_method":{"$ref":"common.schema.json#/$defs/extractionMethod"},"source_record_ids":{"type":"array","items":{"type":"string"}},"evidence_ids":{"type":"array","items":{"type":"string"}},"observed_at":{"type":["string","null"]},"confidence":{"enum":["high","medium","low",null]},"warnings":{"type":"array","items":{"type":"string"}},"derivation":{"$ref":"common.schema.json#/$defs/derivation"}},"additionalProperties":true},
    "binding":{"type":"object","required":["source_record_id","resolution_status","confidence","review_status"],"properties":{"source_record_id":{"type":"string"},"resolution_status":{"enum":["resolved","candidate","ambiguous","unresolved"]},"resolution_basis":{"type":["string","null"]},"confidence":{"enum":["high","medium","low"]},"review_status":{"enum":["not_required","pending","reviewed"]},"conflicting_signals":{"type":"array","items":{"type":"string"}}},"additionalProperties":false},
    "coverage":{"type":"object","required":["capability","status","assessed_at"],"properties":{"capability":{"type":"string"},"status":{"$ref":"common.schema.json#/$defs/coverageStatus"},"assessed_at":{"type":"string"},"observation_ids":{"type":"array","items":{"type":"string"}},"source_record_ids":{"type":"array","items":{"type":"string"}},"evidence_ids":{"type":"array","items":{"type":"string"}},"note":{"type":["string","null"]}},"additionalProperties":false}
  },
  "required":["causebase_id","contract_version","subject_kind","identity","release","source_record_refs","coverage","evidence","activities","beneficiaries","descriptive_geography","funding_sources","fundraising_methods","participation","opportunities","programs"],
  "properties":{
    "causebase_id":{"type":"string","pattern":"^cb_[a-z0-9]+$"},"contract_version":{"const":"0.5"},"subject_kind":{"type":"string"},
    "identity":{"type":"object","required":["legal_name","display_name","external_identifiers","registrations","tax_statuses","website"],"properties":{"legal_name":{"type":"string"},"display_name":{"type":"string"},"website":{"type":["string","null"]},"external_identifiers":{"type":"array","items":{"type":"object","required":["scheme","value","evidence_ids"]}},"registrations":{"type":"array","items":{"type":"object","required":["regulator","status","evidence_ids"]}},"tax_statuses":{"type":"array","items":{"type":"object","required":["scheme","status","evidence_ids"]}}},"additionalProperties":true},
    "release":{"type":"object","required":["release_id","dataset_version","contract_version","based_on_release","generated_at"],"properties":{"release_id":{"type":"string"},"dataset_version":{"type":"string","pattern":".*0\\.5.*"},"contract_version":{"const":"0.5"},"based_on_release":{"type":"string"},"generated_at":{"type":"string"}},"additionalProperties":false},
    "source_record_refs":{"type":"array","items":{"type":"string"}},"source_statement_fixture":{"type":["string","null"]},"source_bindings":{"type":"array","items":{"$ref":"#/$defs/binding"}},"identity_resolution_notice":{"type":["object","null"]},"evidence":{"type":"array","items":{"type":"object","required":["evidence_id","title"]}},
    "summary":{"type":["object","null"]},"activities":{"type":"array","items":{"$ref":"#/$defs/evidenceBound"}},"beneficiaries":{"type":"array","items":{"$ref":"#/$defs/evidenceBound"}},"descriptive_geography":{"type":"array","items":{"$ref":"#/$defs/evidenceBound"}},"funding_sources":{"type":"array","items":{"$ref":"#/$defs/evidenceBound"}},"fundraising_methods":{"type":"array","items":{"$ref":"#/$defs/evidenceBound"}},"participation":{"type":"array","items":{"$ref":"#/$defs/evidenceBound"}},"opportunities":{"type":"array","items":{"$ref":"#/$defs/evidenceBound"}},"programs":{"type":"array","items":{"$ref":"#/$defs/evidenceBound"}},"relationships":{"type":"array","items":{"$ref":"#/$defs/evidenceBound"}},"classifications":{"type":"array","items":{"$ref":"#/$defs/evidenceBound"}},
    "coverage":{"type":"object","required":["registry_id","current"],"properties":{"registry_id":{"type":"string"},"current":{"type":"array","items":{"$ref":"#/$defs/coverage"}}},"additionalProperties":false},"financial_reports":{"type":"array","items":{"$ref":"financial.schema.json#/$defs/report"}},"canonical_metrics":{"type":"array","items":{"$ref":"financial.schema.json#/$defs/metric"}},"current_financials":{"$ref":"financial.schema.json#/$defs/currentFinancials"},"analytic_projections":{"type":"array","items":{"$ref":"financial.schema.json#/$defs/analyticProjection"}},"derivatives":{"type":"array","items":{"$ref":"common.schema.json#/$defs/lineage"}}
  },"additionalProperties":false
}
