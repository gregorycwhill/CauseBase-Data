{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://causebase.example/schema/0.5/release.schema.json", "title": "CauseBase 0.5 release manifest draft", "type": "object",
  "required": ["release_id", "dataset_version", "contract_version", "generated_at", "card_count", "source_record_count", "validation", "artefacts"],
  "properties": {"release_id": {"type": "string"}, "dataset_version": {"type": "string"}, "contract_version": {"const": "0.5"}, "generated_at": {"type": "string", "format": "date-time"}, "card_count": {"type": "integer", "minimum": 0}, "source_record_count": {"type": "integer", "minimum": 0}, "validation": {"type": "object", "required": ["status"], "properties": {"status": {"const": "passed"}}, "additionalProperties": false}, "artefacts": {"type": "array", "items": {"type": "object", "required": ["path", "sha256", "bytes"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "bytes": {"type": "integer", "minimum": 0}}, "additionalProperties": false}}, "compatibility": {"type": "object", "properties": {"previous_contract_versions": {"type": "array", "items": {"type": "string"}}, "migration_note": {"type": "string"}}, "additionalProperties": false}}, "additionalProperties": false
