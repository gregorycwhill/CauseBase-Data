{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://github.com/gregorycwhill/charitygraph-data/blob/main/schemas/vnext/source-record.schema.json", "title": "CharityGraph 0.5 source record draft", "type": "object",
