{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://causebase.example/schema/0.5/financial.schema.json", "title": "CauseBase 0.5 financial draft definitions", "type": "object",
  "$defs": {
    "row": {"allOf": [{"$ref": "common.schema.json#/$defs/observation"}, {"type": "object", "required": ["source_label", "row_type", "source_order"], "properties": {"source_label": {"type": "string"}, "row_type": {"enum": ["heading", "line_item", "subtotal", "total"]}, "source_order": {"type": "integer", "minimum": 0}, "hierarchy_indent": {"type": ["integer", "null"], "minimum": 0}, "amount": {"anyOf":[{"$ref":"common.schema.json#/$defs/money"},{"type":"null"}]}, "comparatives": {"type": "array", "items": {"type": "object", "required": ["period", "amount"], "properties": {"period": {"$ref": "common.schema.json#/$defs/period"}, "amount": {"$ref": "common.schema.json#/$defs/money"}}, "additionalProperties": false}}, "source_location": {"type": ["string", "null"]}, "source_sign": {"enum": ["positive", "negative", "zero", "not_applicable"]}}, "additionalProperties": true}]},
    "statement": {"type": "object", "required": ["statement_id", "statement_type", "printed_title", "reporting_period", "rows"], "properties": {"statement_id": {"type": "string"}, "statement_type": {"enum": ["profit_and_loss", "financial_position", "cash_flow", "changes_in_equity", "other"]}, "printed_title": {"type": "string"}, "reporting_period": {"$ref": "common.schema.json#/$defs/period"}, "reporting_scope": {"enum": ["subject", "organisation_group", "consolidated_group", "unknown"]}, "currency": {"type": "string"}, "source_location": {"type": ["string", "null"]}, "rows": {"type": "array", "items": {"$ref": "#/$defs/row"}}}, "additionalProperties": false},
    "report": {"type": "object", "required": ["financial_report_id", "source_record_id", "evidence_ids", "reporting_period", "statements"], "properties": {"financial_report_id": {"type": "string"}, "source_record_id": {"type": "string"}, "evidence_ids": {"type": "array", "items": {"type": "string"}}, "reporting_period": {"$ref": "common.schema.json#/$defs/period"}, "reporting_scope": {"enum": ["subject", "organisation_group", "consolidated_group", "unknown"]}, "consolidated": {"type": ["boolean", "null"]}, "statements": {"type": "array", "items": {"$ref": "#/$defs/statement"}}, "structured_observations":{"type":"array","items":{"allOf":[{"$ref":"common.schema.json#/$defs/observation"},{"type":"object","required":["metric","amount"],"properties":{"metric":{"type":"string"},"amount":{"$ref":"common.schema.json#/$defs/sourceReportedMoney"}},"additionalProperties":true}]}}, "functional_expense_allocations":{"type":"array","items":{"allOf":[{"$ref":"common.schema.json#/$defs/observation"},{"type":"object","required":["allocation_label","share","share_precision"],"properties":{"allocation_label":{"type":"string"},"share":{"type":"string"},"share_precision":{"type":"string"},"denominator_observation_id":{"type":"string"}},"additionalProperties":true}]}}}, "additionalProperties": false},
    "metric": {"type": "object", "required": ["metric_id", "metric", "observation_id"], "properties": {"metric_id": {"type": "string"}, "metric": {"enum": ["revenue", "total_expenses", "surplus_deficit", "total_assets", "total_liabilities", "net_assets_equity"]}, "observation_id": {"type": "string"}, "sign_normalisation": {"enum": ["as_reported", "absolute_magnitude"]}, "reconciliation_status": {"enum": ["single_observation", "unresolved_conflict", "reconciled", "not_comparable"]}}, "additionalProperties": false},
    "currentFinancials": {"type": "object", "required": ["selection_policy"], "properties": {"selection_policy": {"enum": ["latest_nonconflicted_reporting_period", "explicit_report", "not_selected"]}, "reporting_period": {"$ref": "common.schema.json#/$defs/period"}, "reporting_scope": {"enum": ["subject", "organisation_group", "consolidated_group", "unknown"]}, "revenue_observation_id": {"type": "string"}, "total_expenses_observation_id": {"type": "string"}, "surplus_deficit_observation_id": {"type": "string"}, "total_assets_observation_id": {"type": "string"}, "total_liabilities_observation_id": {"type": "string"}, "net_assets_equity_observation_id": {"type": "string"}}, "additionalProperties": false},
    "analyticProjection": {"allOf": [{"$ref": "common.schema.json#/$defs/observation"}, {"type": "object", "required": ["analytic_kind"], "properties": {"analytic_kind": {"enum": ["donations_gifts_bequests", "fundraising_expenditure", "functional_expense_allocation"]}, "amount": {"$ref": "common.schema.json#/$defs/amount"}, "lower_bound":{"$ref":"common.schema.json#/$defs/amount"},"upper_bound":{"$ref":"common.schema.json#/$defs/amount"},"point_estimate":{"$ref":"common.schema.json#/$defs/amount"},"attribution_components":{"type":"array","items":{"type":"object","required":["observation_id","treatment","additivity_basis"],"properties":{"observation_id":{"type":"string"},"treatment":{"enum":["definite","possible","excluded"]},"additivity_basis":{"type":"string"},"rationale":{"type":["string","null"]}},"additionalProperties":false}}, "component_observation_ids": {"type": "array", "items": {"type": "string"}}, "denominator_observation_id": {"type": ["string", "null"]}, "share": {"type": ["string", "null"]}, "display_amount":{"type":["string","null"]}, "is_approximate":{"type":["boolean","null"]}}, "additionalProperties": true}]}
  }
}
